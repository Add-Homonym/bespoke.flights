# Required
JWT_SECRET=change-me

# Email (optional; logs to stdout when unset)
RESEND_API_KEY=
EMAIL_FROM=Bespoke Flights <hello@bespoke.flights>

# Cron (production)
CRON_SECRET=

# Payments: leave STRIPE_SECRET_KEY empty for simulated payments in development
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
PLATFORM_FEE_BPS=500
APP_URL=http://localhost:3000

# Database: leave DATABASE_URL empty to use the embedded PGlite database locally.
# In Vercel this is set by the Neon integration.
DATABASE_URL=
# PGLITE_DIR=data/pglite
